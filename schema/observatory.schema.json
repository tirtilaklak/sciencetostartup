                    "enum": [
                      "1",
                      "2",
                      "3"
                    ]
                  },
                  "R": {
                    "type": "string",
                    "enum": [
                      "1",
                      "2",
                      "3"
                    ]
                  },
                  "O": {
                    "type": "string",
