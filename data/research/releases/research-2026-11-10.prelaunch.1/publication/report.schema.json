{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sciencetostartup.com/schema/report.schema.json",
  "title": "ScienceToStartup research report",
  "type": "object",
  "required": ["schema_version", "title", "release_id", "updated_on", "status", "source_cutoff", "sections", "editions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "title": {"type": "string", "minLength": 1},
    "release_id": {"type": "string", "minLength": 1},
    "updated_on": {"type": "string", "format": "date"},
    "source_cutoff": {"type": "string", "format": "date-time"},
    "status": {"enum": ["prelaunch", "archive_pending", "published", "superseded"]},
    "editions": {"type": "array", "items": {"type": "object"}},
    "sections": {
      "type": "array", "minItems": 12, "maxItems": 12,
      "items": {
        "type": "object", "required": ["id", "title", "paragraphs"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "title": {"type": "string", "minLength": 1},
          "paragraphs": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "required": ["kind", "text", "claim_ids"],
              "properties": {
                "kind": {"enum": ["sourced_fact", "analysis", "method", "research_gap"]},
                "text": {"type": "string", "minLength": 1},
                "claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "historical": {"type": "boolean"}
              },
              "allOf": [{"if": {"properties": {"kind": {"const": "sourced_fact"}}}, "then": {"properties": {"claim_ids": {"minItems": 1}}}}],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
