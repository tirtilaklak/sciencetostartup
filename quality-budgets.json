{
  "schemaVersion": "1.0.0",
  "policyId": "field-guide-research-budgets-2026-11-09",
  "performance": {
    "lighthouseVersion": "13.6.0",
    "playwrightVersion": "1.65.0",
    "preset": "lighthouse-default-mobile",
    "minimumRunsPerRoute": 3,
    "defaultRunsPerRoute": 3,
    "routes": [
      "/",
      "/explore/#companies",
      "/explore/#work",
      "/explore/#company/mercor/work",
      "/work/",
      "/research/",
      "/research/state-of-ai-data-labs/",
      "/research/data/",
      "/review/"
    ],
    "medianLimits": {
      "largest-contentful-paint": { "maximum": 2500, "unit": "ms" },
      "total-blocking-time": { "maximum": 200, "unit": "ms" },
      "cumulative-layout-shift": { "maximum": 0.05, "unit": "unitless" }
    },
    "chromeFlags": ["--headless=new", "--no-sandbox"]
  },
  "payload": {
    "compression": {
      "brotliQuality": 6,
      "gzipLevel": 6
    },
    "bootstrap": {
      "entry": "explore/index.html",
      "currentScriptFamilies": ["data", "app"],
      "maximumBrotliBytes": 307200,
      "maximumGzipBytes": 368640,
      "forbidCanonicalArchive": true
    },
    "home": {
      "entry": "index.html",
      "maximumGzipBytes": 12288,
      "runtime": "home-runtime.js",
      "maximumRuntimeGzipBytes": 5120,
      "heroVariants": [
        { "role": "mobile", "path": "assets/human-depth-portrait-400.webp", "maximumBytes": 150000 },
        { "role": "desktop", "path": "assets/human-depth-portrait-600.webp", "maximumBytes": 250000 }
      ],
      "maximumSelectedMobileHeroBytes": 150000
    },
    "requireManifestCoverage": true,
    "verifyAllManifestDigests": true
  }
}
